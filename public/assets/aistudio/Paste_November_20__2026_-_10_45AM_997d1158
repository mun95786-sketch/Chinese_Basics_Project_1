    function setWriterStatus(text, type = "info") {
      els.writerStatus.textContent = text;
      els.writerStatus.className = `writer-status ${type}`;
    }

    function renderStudyCard() {
      const word = getCurrentWord();
      if (!word) return;
      state.studiedIds.add(word.id);
      saveStudiedIds();
      renderProgress();

      els.wordLevelBadge.textContent = word.level;
      els.wordLevelBadge.className = `badge badge-lv-${word.level}`;
      els.wordCategoryBadge.textContent = word.category;
      els.wordStudiedBadge.style.display = "inline-flex";
