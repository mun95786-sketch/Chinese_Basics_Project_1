          <div style="display:flex; justify-content:center; gap:10px; flex-wrap:wrap;">
            <button class="btn btn-primary" id="goLearnFromQuizBtn">📖 단어 학습하기</button>
            <button class="btn btn-blue-soft" id="switchAllSourceBtn">🎲 전체 단어로 풀기</button>
          </div>
        </div>
      `;
      document.getElementById("goLearnFromQuizBtn").addEventListener("click", () => switchTab("learn"));
      document.getElementById("switchAllSourceBtn").addEventListener("click", () => setQuizSource("all"));
    }

    function renderQuizStep() {
      const q = state.quiz;
      if (q.finished) {
        renderQuizResult();
        return;
      }

      const item = q.questions[q.qIndex];
      if (!item) return;

      const totalCount = q.questions.length;
      const isLast = q.qIndex === totalCount - 1;
      const showPinyin = q.answered || q.showPinyinHint;

      if (item.kind === "word") {
        els.quizCardBody.innerHTML = `
          <div class="quiz-progress-badge">문제 ${q.qIndex + 1} / ${totalCount} · ${item.level} · ${q.choiceCount}지선다</div>
          <div class="quiz-question-label">다음 중국어 단어의 알맞은 뜻은?</div>
          <div class="quiz-prompt-main">${item.promptZh}</div>
          <div class="quiz-pinyin">${showPinyin ? item.promptPinyin : ""}</div>
          <div class="quiz-helper-row">
            <button class="btn btn-blue-soft btn-sm" id="quizSpeakNormalBtn">🔊 발음 듣기</button>
            <button class="btn btn-blue-soft btn-sm" id="quizSpeakSlowBtn">🐢 0.7배속</button>
            ${!q.answered ? `<button class="btn btn-sm" id="quizHintBtn">${q.showPinyinHint ? "병음 숨기기" : "💡 병음 힌트"}</button>` : ""}
          </div>
          ${renderOptionsHtml(item, q)}
          ${renderFeedbackHtml(item, q, isLast)}
        `;
      } else {
        els.quizCardBody.innerHTML = `
          <div class="quiz-progress-badge">문제 ${q.qIndex + 1} / ${totalCount} · ${item.level} (${item.category}) · ${q.choiceCount}지선다</div>
          <div class="quiz-question-label">다음 한국어에 알맞은 중국어 회화 문장은?</div>
          <div class="quiz-prompt-ko">“${item.promptKo}”</div>
          <div class="quiz-helper-row">
            ${!q.answered ? `<button class="btn btn-sm" id="quizHintBtn">${q.showPinyinHint ? "병음 숨기기" : "💡 선택지 병음 보기"}</button>` : ""}
            ${q.answered ? `
              <button class="btn btn-blue-soft btn-sm" id="quizSpeakNormalBtn">🔊 정답 발음 듣기</button>
              <button class="btn btn-blue-soft btn-sm" id="quizSpeakSlowBtn">🐢 0.7배속</button>
            ` : ""}
          </div>
          ${renderOptionsHtml(item, q, showPinyin)}
          ${renderFeedbackHtml(item, q, isLast)}
        `;
      }

      const speakNorm = document.getElementById("quizSpeakNormalBtn");
      const speakSlow = document.getElementById("quizSpeakSlowBtn");
      if (speakNorm) speakNorm.addEventListener("click", e => speakChinese(item.speakText, 1.0, e.currentTarget));
      if (speakSlow) speakSlow.addEventListener("click", e => speakChinese(item.speakText, 0.7, e.currentTarget));

      const hintBtn = document.getElementById("quizHintBtn");
      if (hintBtn) {
        hintBtn.addEventListener("click", () => {
          q.showPinyinHint = !q.showPinyinHint;
          renderQuizStep();
        });
      }

      els.quizCardBody.querySelectorAll(".quiz-option").forEach(btn => {
        btn.addEventListener("click", () => {
          if (q.answered) return;
          const idx = Number(btn.dataset.idx);
          const ok = item.options[idx].isCorrect;
          q.answered = true;
          q.selectedIdx = idx;
          q.results.push({
            prompt: item.kind === "word" ? `${item.promptZh} (${item.promptPinyin})` : item.promptKo,
            answer: item.answerText,
            isCorrect: ok
          });
          renderQuizStep();
        });
      });

      const nextBtn = document.getElementById("nextQuizBtn");
      if (nextBtn) {
        nextBtn.addEventListener("click", () => {
          if (isLast) {
            q.finished = true;
          } else {
            q.qIndex += 1;
            q.answered = false;
            q.selectedIdx = -1;
            q.showPinyinHint = false;
          }
          renderQuizStep();
        });
      }
    }

    function renderOptionsHtml(item, q, showSubPinyin = false) {
      return `
        <div class="quiz-options">
          ${item.options.map((opt, idx) => {
            let cls = "quiz-option";
            if (q.answered) {
              if (opt.isCorrect) cls += " correct";
              else if (idx === q.selectedIdx) cls += " wrong";
            }
            const showSub = opt.sub && (q.answered || showSubPinyin);
            return `
              <button class="${cls}" data-idx="${idx}" ${q.answered ? "disabled" : ""}>
                <span class="option-num">${idx + 1}</span>
                <span>
                  <span>${opt.label}</span>
                  ${showSub ? `<span class="quiz-option-sub">${opt.sub}</span>` : ""}
                </span>
              </button>
            `;
          }).join("")}
        </div>
      `;
    }

    function renderFeedbackHtml(item, q, isLast) {
      if (!q.answered) return "";
      const isCorrect = q.options[q.selectedIdx]?.isCorrect;
      return `
        <div class="quiz-feedback show ${isCorrect ? "is-correct" : "is-wrong"}">
          ${isCorrect
            ? `⭕ 정답입니다! (${item.promptZh} : ${item.answerText})`
            : `❌ 오답입니다! 정답은 「${item.answerText}」 입니다.`}
        </div>
        <button class="btn btn-primary" id="nextQuizBtn">
          ${isLast ? "📊 결과 확인하고 마치기" : "다음 문제 ➡️"}
        </button>
      `;
    }

    // 세트 완료 시: 몇 개 중 몇 개 맞았는지 표시하고 더 진행하지 않음
    function renderQuizResult() {
      const q = state.quiz;
      const total = q.results.length;
      const correctCount = q.results.filter(r => r.isCorrect).length;
      const pct = total > 0 ? Math.round((correctCount / total) * 100) : 0;

      els.quizCardBody.innerHTML = `
        <div class="quiz-progress-badge">퀴즈 완료</div>
        <div class="result-score-big">${total}개 중 ${correctCount}개 정답!</div>
        <div class="result-sub">정답률 ${pct}% · 수고하셨습니다. 이번 퀴즈가 종료되었습니다.</div>
        <div class="result-list">
          ${q.results.map((r, i) => `
            <div class="result-item ${r.isCorrect ? "ok" : "no"}">
              <div>
                <strong>${i + 1}. ${r.prompt}</strong><br>
                <span style="color:var(--muted);">정답: ${r.answer}</span>
              </div>
              <span style="font-weight:800; flex-shrink:0;">${r.isCorrect ? "⭕ 정답" : "❌ 오답"}</span>
            </div>
          `).join("")}
        </div>
        <button class="btn btn-primary" id="finishBackLearnBtn">📖 단어·쓰기 학습으로 돌아가기</button>
      `;

      document.getElementById("finishBackLearnBtn").addEventListener("click", () => switchTab("learn"));
    }

    function setQuizSource(src) {
      state.quiz.source = src;
      els.quizSourceSwitch.querySelectorAll(".mode-btn").forEach(b => b.classList.toggle("active", b.dataset.source === src));
      initQuizSession();
    }

    // =====================================================
    // 9. 탭 전환 및 이벤트 연결
    // =====================================================
    function switchTab(tabName) {
      els.tabButtons.forEach(btn => {
        const active = btn.dataset.tab === tabName;
        btn.classList.toggle("active", active);
        btn.setAttribute("aria-selected", String(active));
      });
      Object.entries(els.panels).forEach(([key, panel]) => {
        panel.classList.toggle("active", key === tabName);
      });
      if (tabName === "learn") initHanziWriterForCurrentChar();
      if (tabName === "quiz") initQuizSession();
    }

    els.tabButtons.forEach(btn => btn.addEventListener("click", () => switchTab(btn.dataset.tab)));

    els.levelSelect.addEventListener("change", () => {
      state.currentLevel = els.levelSelect.value;
      applyWordFilters();
    });

    els.categorySelect.addEventListener("change", () => {
      state.currentCategory = els.categorySelect.value;
      applyWordFilters();
    });

    els.wordSelect.addEventListener("change", () => {
      state.currentIndex = Number(els.wordSelect.value);
      renderStudyCard();
    });

    els.prevWordBtn.addEventListener("click", () => moveWord(-1));
    els.nextWordBtn.addEventListener("click", () => moveWord(1));
    els.randomWordBtn.addEventListener("click", pickRandomWord);

    els.toggleMeaningBtn.addEventListener("click", () => {
      state.hideMeaning = !state.hideMeaning;
      els.meaningDisplay.classList.toggle("hidden-meaning", state.hideMeaning);
      els.toggleMeaningBtn.textContent = state.hideMeaning ? "뜻 보기" : "뜻 가리기";
    });

    els.speakNormalBtn.addEventListener("click", e => speakChinese(getCurrentWord().hanzi, 1.0, e.currentTarget, els.ttsNotice));
    els.speakSlowBtn.addEventListener("click", e => speakChinese(getCurrentWord().hanzi, 0.7, e.currentTarget, els.ttsNotice));

    // 퀴즈 설정 변경 이벤트
    els.quizTypeSwitch.querySelectorAll(".mode-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        state.quiz.type = btn.dataset.qtype;
        els.quizTypeSwitch.querySelectorAll(".mode-btn").forEach(b => b.classList.toggle("active", b === btn));
        initQuizSession();
      });
    });

    els.quizLevelSelect.addEventListener("change", () => {
      state.quiz.level = els.quizLevelSelect.value;
      initQuizSession();
    });

    els.quizChoiceSwitch.querySelectorAll(".mode-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        state.quiz.choiceCount = Number(btn.dataset.choices);
        els.quizChoiceSwitch.querySelectorAll(".mode-btn").forEach(b => b.classList.toggle("active", b === btn));
        initQuizSession();
      });
    });

    els.quizSourceSwitch.querySelectorAll(".mode-btn").forEach(btn => {
      btn.addEventListener("click", () => setQuizSource(btn.dataset.source));
    });

    els.resetProgressBtn.addEventListener("click", () => {
      if (!confirm("지금까지 학습한 단어 기록을 초기화할까요?")) return;
      state.studiedIds = new Set([getCurrentWord().id]);
      saveStudiedIds();
      renderProgress();
      if (els.panels.quiz.classList.contains("active")) initQuizSession();
    });

    document.addEventListener("keydown", evt => {
      const tag = document.activeElement?.tagName;
      if (tag === "SELECT" || tag === "INPUT" || tag === "TEXTAREA") return;
      if (!els.panels.learn.classList.contains("active")) return;
      if (evt.key === "ArrowLeft") moveWord(-1);
      if (evt.key === "ArrowRight") moveWord(1);
    });

    // 초기 실행
    applyWordFilters();
    renderConversationUI();
    renderCultureUI();
  </script>
</body>
</html>