    // =====================================================
    // 8. 퀴즈 탭 (단어·회화 맞추기, 3지선다·5지선다, 세트 완료 후 종료)
    // =====================================================
    function shuffleArray(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function initQuizSession() {
      const q = state.quiz;
      q.questions = [];
      q.qIndex = 0;
      q.answered = false;
      q.selectedIdx = -1;
      q.showPinyinHint = false;
      q.results = [];
      q.finished = false;

      // 회화 퀴즈일 때는 source 스위치 숨김(회화 문장 전체/난이도별 출제)
      els.quizSourceSwitch.style.display = q.type === "word" ? "inline-flex" : "none";

      if (q.type === "word") {
        let levelPool = q.level === "전체" ? VOCAB_LIST : VOCAB_LIST.filter(w => w.level === q.level);
        let questionPool = q.source === "studied"
          ? levelPool.filter(w => state.studiedIds.has(w.id))
          : levelPool;

        if (questionPool.length === 0) {
          renderQuizEmpty(`선택한 난이도(${q.level})에서 아직 학습한 단어가 없습니다.`);
          return;
        }

        const picked = shuffleArray(questionPool).slice(0, Math.min(QUIZ_MAX_QUESTIONS, questionPool.length));
        q.questions = picked.map(word => {
          // 오답 보기는 같은 난이도 전체 단어 풀에서 뽑아 3/5지선다를 항상 채울 수 있게 함
          const distractorCandidates = levelPool.filter(w => w.id !== word.id && w.meaning !== word.meaning);
          const distractors = shuffleArray(distractorCandidates).slice(0, q.choiceCount - 1);
          const options = shuffleArray([
            { label: word.meaning, sub: "", isCorrect: true },
            ...distractors.map(d => ({ label: d.meaning, sub: "", isCorrect: false }))
          ]);
          return {
            kind: "word",
            level: word.level,
            promptZh: word.hanzi,
            promptPinyin: word.pinyin,
            answerText: word.meaning,
            speakText: word.hanzi,
            options
          };
        });
      } else {
        // 회화 문장 맞추기 (한국어 상황/뜻 보고 알맞은 중국어 회화 문장 고르기)
        const levelPool = q.level === "전체" ? CONVERSATION_LIST : CONVERSATION_LIST.filter(c => c.level === q.level);
        const picked = shuffleArray(levelPool).slice(0, Math.min(QUIZ_MAX_QUESTIONS, levelPool.length));

        q.questions = picked.map(conv => {
          const distractorCandidates = levelPool.filter(c => c.id !== conv.id && c.zh !== conv.zh);
          const distractors = shuffleArray(distractorCandidates).slice(0, q.choiceCount - 1);
          const options = shuffleArray([
            { label: conv.zh, sub: conv.pinyin, isCorrect: true },
            ...distractors.map(d => ({ label: d.zh, sub: d.pinyin, isCorrect: false }))
          ]);
          return {
            kind: "conv",
            level: conv.level,
            category: conv.category,
            promptKo: conv.ko,
            promptZh: conv.zh,
            promptPinyin: conv.pinyin,
            answerText: conv.zh,
            speakText: conv.zh,
            options
          };
        });
      }

      renderQuizStep();
    }

    function renderQuizEmpty(msg) {
      els.quizCardBody.innerHTML = `
        <div class="empty-quiz-box">
          <h3>출제할 문제가 아직 부족해요</h3>
