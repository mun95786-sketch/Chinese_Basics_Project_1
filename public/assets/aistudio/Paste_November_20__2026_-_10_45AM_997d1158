      els.pinyinDisplay.textContent = word.pinyin;
      els.meaningDisplay.textContent = word.meaning;
      els.meaningDisplay.classList.toggle("hidden-meaning", state.hideMeaning);
      els.toggleMeaningBtn.textContent = state.hideMeaning ? "뜻 보기" : "뜻 가리기";
      els.wordSelect.value = String(state.currentIndex);

      const chars = Array.from(word.hanzi);
      state.selectedCharIdx = 0;
      els.charSelector.innerHTML = chars.map((ch, idx) =>
        `<button class="char-chip ${idx === 0 ? "active" : ""}" data-idx="${idx}">${ch}</button>`
      ).join("");

      els.charSelector.querySelectorAll(".char-chip").forEach(btn => {
        btn.addEventListener("click", () => {
          state.selectedCharIdx = Number(btn.dataset.idx);
          els.charSelector.querySelectorAll(".char-chip").forEach(c => c.classList.remove("active"));
          btn.classList.add("active");
          initHanziWriterForCurrentChar();
        });
      });

      initHanziWriterForCurrentChar();
    }

    function initHanziWriterForCurrentChar() {
      const word = getCurrentWord();
      const chars = Array.from(word.hanzi);
      const targetChar = chars[state.selectedCharIdx] || chars[0];
      const token = ++state.renderToken;

      if (state.writer) {
        try { state.writer.cancelQuiz(); } catch (e) {}
        state.writer = null;
      }
      els.hanziTarget.innerHTML = "";

      if (typeof HanziWriter === "undefined") {
        setWriterStatus("Hanzi Writer CDN을 불러오지 못했습니다. 인터넷 연결을 확인하세요.", "warn");
        return;
      }

      const size = els.tianziBox.clientWidth || 270;
      setWriterStatus(`'${targetChar}' 쓰기 준비 중...`, "info");

      state.writer = HanziWriter.create("hanziTarget", targetChar, {
        width: size, height: size, padding: 14, showOutline: true, showCharacter: false,
        strokeAnimationSpeed: 1.15, delayBetweenStrokes: 220,
        strokeColor: "#1e293b", outlineColor: "#cbd5e1", drawingColor: "#dc2626",
        drawingWidth: 18, highlightColor: "#2563eb", highlightOnComplete: true,
        onLoadCharDataSuccess: () => {
          // 모르는 경우에만 애니메이션을 보도록, 로드 즉시 쓰기 퀴즈 모드로 진입
          if (token === state.renderToken) startStrokeQuiz(token, targetChar);
        },
        onLoadCharDataError: () => {
          if (token === state.renderToken) setWriterStatus(`'${targetChar}' 한자 데이터를 불러오지 못했습니다.`, "warn");
        }
      });
    }

    function playAnimationThenQuiz(token, charLabel) {
      if (!state.writer || token !== state.renderToken) return;
      try { state.writer.cancelQuiz(); } catch (e) {}
      setWriterStatus(`🎬 '${charLabel}' 획순 애니메이션 재생 중...`, "info");
      state.writer.animateCharacter({
        onComplete: () => {
          if (token === state.renderToken) startStrokeQuiz(token, charLabel);
        }
      });
    }

    function startStrokeQuiz(token, charLabel) {
      if (!state.writer || token !== state.renderToken) return;
      setWriterStatus(`✍️ '${charLabel}' 획순에 맞춰 직접 써 보세요! (모르면 아래 획순 보기)`, "info");
      state.writer.quiz({
        showHintAfterMisses: 2,
        highlightOnComplete: true,
        onCorrectStroke: d => {
          if (token === state.renderToken && d.strokesRemaining > 0) {
            setWriterStatus(`👍 좋아요! 남은 획수: ${d.strokesRemaining}획`, "info");
          }
        },
        onMistake: () => {
          if (token === state.renderToken) setWriterStatus("💡 획순과 방향이 다릅니다! (모르면 '획순 보기' 클릭)", "warn");
        },
        onComplete: d => {
          if (token === state.renderToken) setWriterStatus(`🎉 '${charLabel}' 쓰기 완료! (실수 ${d.totalMistakes}회)`, "success");
        }
      });
    }

    // 모르는 경우에만 획순 애니메이션 보기
    els.showStrokeAnimBtn.addEventListener("click", () => {
      const chars = Array.from(getCurrentWord().hanzi);
      playAnimationThenQuiz(state.renderToken, chars[state.selectedCharIdx] || chars[0]);
    });

    els.clearWriteBtn.addEventListener("click", () => {
      if (!state.writer) return;
      const chars = Array.from(getCurrentWord().hanzi);
      try { state.writer.cancelQuiz(); state.writer.hideCharacter(); } catch (e) {}
      startStrokeQuiz(state.renderToken, chars[state.selectedCharIdx] || chars[0]);
    });

    function moveWord(delta) {
      const len = state.filteredWords.length;
      state.currentIndex = (state.currentIndex + delta + len) % len;
      renderStudyCard();
    }

    function pickRandomWord() {
      const len = state.filteredWords.length;
      if (len <= 1) return;
      let nextIdx = state.currentIndex;
      while (nextIdx === state.currentIndex) nextIdx = Math.floor(Math.random() * len);
      state.currentIndex = nextIdx;
      renderStudyCard();
    }

