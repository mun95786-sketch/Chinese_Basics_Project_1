    // =====================================================
    // 4. Web Speech API (zh-CN)
    // =====================================================
    let zhVoices = [];
    function loadVoices() {
      if (!("speechSynthesis" in window)) return;
      zhVoices = window.speechSynthesis.getVoices().filter(v =>
        v.lang.toLowerCase().includes("zh-cn") || v.lang.toLowerCase().includes("zh_cn") || v.lang.toLowerCase().startsWith("zh")
      );
    }
    if ("speechSynthesis" in window) {
      loadVoices();
      window.speechSynthesis.onvoiceschanged = loadVoices;
    }

    function clearSpeakingStyles() {
      document.querySelectorAll(".btn-speaking").forEach(b => b.classList.remove("btn-speaking"));
    }

    function speakChinese(text, rate = 1.0, triggerBtn = null, noticeEl = null) {
      if (!("speechSynthesis" in window)) {
        if (noticeEl) noticeEl.textContent = "이 브라우저는 Web Speech API 음성 합성을 지원하지 않습니다.";
        return;
      }
      window.speechSynthesis.cancel();
      clearSpeakingStyles();
      const utter = new SpeechSynthesisUtterance(text);
      utter.lang = "zh-CN";
      utter.rate = rate;
      const preferred = zhVoices.find(v => v.lang.toLowerCase() === "zh-cn" || v.lang.toLowerCase() === "zh_cn") || zhVoices[0];
      if (preferred) utter.voice = preferred;
      utter.onstart = () => {
        if (triggerBtn) triggerBtn.classList.add("btn-speaking");
        if (noticeEl) noticeEl.textContent = rate < 1 ? "0.7배속으로 천천히 발음하는 중..." : "중국어(zh-CN) 발음 재생 중...";
      };
      utter.onend = () => { clearSpeakingStyles(); if (noticeEl) noticeEl.textContent = ""; };
      utter.onerror = () => { clearSpeakingStyles(); if (noticeEl) noticeEl.textContent = "음성 재생 오류: 기기의 중국어 TTS 설정을 확인하세요."; };
      window.speechSynthesis.speak(utter);
    }

    // =====================================================
    // 5. 단어 학습 & Hanzi Writer (모르는 경우에만 애니메이션)
    // =====================================================
    function applyWordFilters() {
      const byLevel = state.currentLevel === "전체"
        ? VOCAB_LIST
        : VOCAB_LIST.filter(w => w.level === state.currentLevel);

      const categories = ["전체", ...new Set(byLevel.map(w => w.category))];
      if (!categories.includes(state.currentCategory)) state.currentCategory = "전체";

      els.categorySelect.innerHTML = categories.map(cat => {
        const cnt = cat === "전체" ? byLevel.length : byLevel.filter(w => w.category === cat).length;
        return `<option value="${cat}">${cat} (${cnt})</option>`;
      }).join("");
      els.categorySelect.value = state.currentCategory;

      state.filteredWords = state.currentCategory === "전체"
        ? byLevel
        : byLevel.filter(w => w.category === state.currentCategory);

      state.currentIndex = 0;
      populateWordSelect();
      renderStudyCard();
    }

    function populateWordSelect() {
      els.wordSelect.innerHTML = state.filteredWords.map((w, idx) =>
        `<option value="${idx}">${idx + 1}. ${w.hanzi} (${w.meaning})</option>`
      ).join("");
      els.wordSelect.value = String(state.currentIndex);
    }

    function getCurrentWord() {
      return state.filteredWords[state.currentIndex] || VOCAB_LIST[0];
    }

    function renderProgress() {
      const count = state.studiedIds.size;
      const total = VOCAB_LIST.length;
      els.progressText.textContent = `학습 ${count} / ${total}`;
      els.progressBar.style.width = `${Math.round((count / total) * 100)}%`;
